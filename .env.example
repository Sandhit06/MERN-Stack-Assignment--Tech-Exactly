NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/margin_dev
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-another-32-random-characters
ADMIN_EMAIL=admin@margin.local
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Margin Editor
